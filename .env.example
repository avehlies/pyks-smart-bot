# Copy to .env and fill in. Names match the TypeScript bot where possible.

# --- Discord ---
AUTH_TOKEN=
# Your Discord user ID: may use the owner-only commands (!sync, !ping, !newmember, !backfillclips)
# and skips cooldowns. Defaults to the TS bot's owner (293571605081358336).
OWNER_ID=
# Comma-separated user IDs the bot ignores completely.
BLOCKED_USER_IDS=

# --- Server / channels ---
YKS_GUILD_ID=
YKS_CLIP_CHANNEL_ID=
YKS_MAILBAG_CHANNEL_ID=
YKS_KICKSTARTER_BOT_CHANNEL_ID=
# recipe-interceptor replies to cooking.nytimes.com / bonappetit.com links here.
YKS_FOOD_CHANNEL_ID=682325132127371341
# #yks-shit: the short-worker posts new YouTube Shorts here, and !short only answers here.
YKS_SHORTS_CHANNEL_ID=672146620275621918

# --- Podcast feeds ---
MAIN_FEED_RSS=
BONUS_FEED_RSS=

# --- Database ---
# docker-compose sets DATABASE_URL for its containers; this is for running the bot on your machine.
DATABASE_URL=postgresql://yks:yks@localhost:5432/yks
POSTGRES_PASSWORD=yks

# --- Clips ---
# Set to true (once) to record every clip in the clip channel's history on startup.
# The owner can also run !backfillclips at any time.
GATHER_ALL_CLIPS=false

# --- Clip worker (the clip-worker service; uses AUTH_TOKEN and DATABASE_URL too) ---
# Any faster-whisper model: tiny.en, base.en, small.en, medium.en, large-v3, ...
WHISPER_MODEL=tiny.en
# cpu or cuda; int8 is fast on CPU, float16 on a GPU.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Lower is faster on a CPU (1 = greedy decoding), higher is slightly more accurate (up to ~5).
WHISPER_BEAM_SIZE=3
# CPU threads for the model (0 = faster-whisper's default, 4). Lower it to leave CPU for the bot.
WHISPER_CPU_THREADS=0
# Free the model's memory after this many idle seconds (0 = keep it loaded).
WHISPER_IDLE_UNLOAD_SECONDS=300
# Attempts per clip before it's marked failed.
MAX_ATTEMPTS=3

# --- Short worker (the pyks_short_worker service; uses AUTH_TOKEN, DATABASE_URL and
# YKS_SHORTS_CHANNEL_ID too) ---
# The YouTube channel to watch: its @handle (Shorts page) and its UC... id (RSS feed).
YOUTUBE_HANDLE=YourKickstarterSucks
YOUTUBE_CHANNEL_ID=UCt_yVzAjE5AQUNMlLAw5jtA
SCAN_INTERVAL_MINUTES=30
# Shorts older than this when first found are recorded without being posted.
ANNOUNCE_MAX_AGE_HOURS=72

# --- HTTP server (/healthz) ---
# Host port for the healthcheck endpoint (inside the container it's always 3000).
PORT=3000

# Timezone for date-based behaviour (!today, April 7 Burgy day).
BOT_TIMEZONE=America/Chicago

LOG_LEVEL=INFO
