# Copy to .env and fill in. Names match the TypeScript bot where possible.

# --- Discord ---
AUTH_TOKEN=
# Your Discord user ID: may use the owner-only commands (!sync, !ping, !newmember, !backfillclips)
# and skips cooldowns. Defaults to the TS bot's owner (293571605081358336).
OWNER_ID=
# Comma-separated user IDs the bot ignores completely.
BLOCKED_USER_IDS=

# --- Server / channels ---
YKS_GUILD_ID=
YKS_CLIP_CHANNEL_ID=
YKS_MAILBAG_CHANNEL_ID=
YKS_KICKSTARTER_BOT_CHANNEL_ID=

# --- Podcast feeds ---
MAIN_FEED_RSS=
BONUS_FEED_RSS=

# --- Database ---
# docker-compose sets DATABASE_URL for its containers; this is for running the bot on your machine.
DATABASE_URL=postgresql://yks:yks@localhost:5432/yks
POSTGRES_PASSWORD=yks

# --- Clips ---
# Set to true (once) to record every clip in the clip channel's history on startup.
# The owner can also run !backfillclips at any time.
GATHER_ALL_CLIPS=false

# --- Clip worker (the clip-worker service; uses AUTH_TOKEN and DATABASE_URL too) ---
# Any faster-whisper model: tiny.en, base.en, small.en, medium.en, large-v3, ...
WHISPER_MODEL=tiny.en
# cpu or cuda; int8 is fast on CPU, float16 on a GPU.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Free the model's memory after this many idle seconds (0 = keep it loaded).
WHISPER_IDLE_UNLOAD_SECONDS=300
# Attempts per clip before it's marked failed.
MAX_ATTEMPTS=3

# --- HTTP API (/api/share-clip) ---
# Host port for the API (inside the container it's always 3000).
PORT=3000
BOT_AUTH_USERNAME=
BOT_AUTH_PASSWORD=

# Timezone for date-based behaviour (!today, April 7 Burgy day).
BOT_TIMEZONE=America/Chicago

LOG_LEVEL=INFO
